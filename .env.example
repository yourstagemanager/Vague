# ==============================================
# VAGUE AI CONFIGURATION
# ==============================================
# Copy this file to .env and configure your AI provider
#
# IMPORTANT: Add .env to your .gitignore to protect API keys!
# ==============================================

# =============== AI PROVIDER ==================
# Choose your AI provider:
#   - 'gemini' = Google Gemini API (Free tier: 250 requests/day)
#   - 'ollama' = Local LLM via Ollama (Unlimited, free, offline)
#   - 'none'   = Use canned responses only (no AI)
VITE_AI_PROVIDER=none

# ============= GOOGLE GEMINI ==================
# Get free API key: https://aistudio.google.com/apikey
# Free tier limits:
#   - Gemini 2.0 Flash: 10 requests/min, 250/day
#   - Gemini 1.5 Flash: 15 requests/min, 1000/day

VITE_GEMINI_API_KEY=

# Available models:
#   - gemini-2.0-flash-exp (Recommended: Fast, free)
#   - gemini-1.5-flash (Alternative: Slower but higher quota)
VITE_GEMINI_MODEL=gemini-2.0-flash-exp

# ================ OLLAMA =====================
# Install Ollama: https://ollama.com/download
# Then run: ollama pull llama3.2:3b
#
# Recommended models:
#   - llama3.2:3b   (3B params, fast, needs 8GB RAM)
#   - llama3:8b     (8B params, better quality, needs 16GB RAM)
#   - mistral:7b    (7B params, good balance, needs 16GB RAM)
#   - phi3:mini     (3.8B params, lightweight, needs 8GB RAM)

VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2:3b

# ==============================================
# QUICK START GUIDE
# ==============================================
#
# OPTION 1: Use Google Gemini (Easiest)
# --------------------------------------
# 1. Get free API key: https://aistudio.google.com/apikey
# 2. Copy this file to .env
# 3. Set VITE_AI_PROVIDER=gemini
# 4. Paste your key in VITE_GEMINI_API_KEY
# 5. Run: npm run dev
#
# OPTION 2: Use Ollama (Free, Unlimited)
# --------------------------------------
# 1. Install Ollama: https://ollama.com/download
# 2. Run: ollama pull llama3.2:3b
# 3. Copy this file to .env
# 4. Set VITE_AI_PROVIDER=ollama
# 5. Run: npm run dev
#
# OPTION 3: No AI (Canned Responses Only)
# ----------------------------------------
# 1. Set VITE_AI_PROVIDER=none
# 2. Responses will be random pre-written jokes
#
# ==============================================
